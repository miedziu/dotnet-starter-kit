<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FSH.Starter.DbMigrator</RootNamespace>
    <AssemblyName>FSH.Starter.DbMigrator</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Container configuration — published as a one-shot job image used as
         the migrate step in a Kubernetes Job / Helm pre-install hook / Aspire
         dependency. Same base image as the API for parity. Image is built via
         `dotnet publish /t:PublishContainer` — no PublishProfile needed (the
         legacy "DefaultContainer" profile auto-populates ContainerImageTag
         from $(Version), colliding with ContainerImageTags). -->
    <ContainerUser>1654</ContainerUser>
    <ContainerFamily>noble</ContainerFamily>
    <ContainerRepository>fsh-db-migrator</ContainerRepository>

    <!-- This is an internal operator-facing CLI — no localization, all
         operator messages are literal strings. CA1303 (use resource tables
         for user-facing strings) is the wrong rule for this project. -->
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Lib\Web\Web.csproj" />
    <ProjectReference Include="..\..\Mods\Audit\Src\Audit.Src.csproj" />
    <ProjectReference Include="..\..\Mods\Audit\Spec\Audit.Spec.csproj" />
    <ProjectReference Include="..\..\Mods\Billing\Src\Billing.Src.csproj" />
    <ProjectReference Include="..\..\Mods\Billing\Spec\Billing.Spec.csproj" />
    <ProjectReference Include="..\..\Mods\Chat\Src\Chat.Src.csproj" />
    <ProjectReference Include="..\..\Mods\Chat\Spec\Chat.Spec.csproj" />
    <ProjectReference Include="..\..\Mods\File\Src\File.Src.csproj" />
    <ProjectReference Include="..\..\Mods\File\Spec\File.Spec.csproj" />
    <ProjectReference Include="..\..\Mods\Identity\Src\Identity.Src.csproj" />
    <ProjectReference Include="..\..\Mods\Ticket\Src\Ticket.Src.csproj" />
    <ProjectReference Include="..\..\Mods\Ticket\Spec\Ticket.Spec.csproj" />
    <ProjectReference Include="..\..\Mods\Webhook\Src\Webhook.Src.csproj" />
    <ProjectReference Include="..\Migrations\Migrations.csproj" />
  </ItemGroup>

  <!-- Share configuration with the API so connection strings + tenant options
       stay in lock-step. Production deployments override via env vars. -->
  <ItemGroup>
    <None Include="..\Api\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Api\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
