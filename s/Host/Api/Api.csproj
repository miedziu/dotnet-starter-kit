<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>FSH.Starter.Api</RootNamespace>
		<AssemblyName>FSH.Starter.Api</AssemblyName>
		<IsPackable>false</IsPackable>

		<!-- Container configuration — image is built via `dotnet publish /t:PublishContainer`.
		     No PublishProfile needed (the legacy "DefaultContainer" profile auto-populates
		     ContainerImageTag from $(Version), which collides with ContainerImageTags). -->
		<ContainerPort>8080</ContainerPort>
		<ContainerUser>1654</ContainerUser>
		<ContainerFamily>noble</ContainerFamily>
		<ContainerRepository>fsh-api</ContainerRepository>
		<UserSecretsId>fde33270-f828-41af-878c-55a96e37120f</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Mediator.Abstractions" />
		<PackageReference Include="Mediator.SourceGenerator">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Lib\Web\Web.csproj" />
    <ProjectReference Include="..\..\Mods\Audit\Spec\Audit.Spec.csproj" />
    <ProjectReference Include="..\..\Mods\Audit\Src\Audit.Src.csproj" />
    <ProjectReference Include="..\..\Mods\Identity\Src\Identity.Src.csproj" />
    <ProjectReference Include="..\Migrations\Migrations.csproj" />
    <ProjectReference Include="..\..\Mods\Webhook\Src\Webhook.Src.csproj" />
    <ProjectReference Include="..\..\Mods\Billing\Src\Billing.Src.csproj" />
    <ProjectReference Include="..\..\Mods\Billing\Spec\Billing.Spec.csproj" />
    <ProjectReference Include="..\..\Mods\Ticket\Src\Ticket.Src.csproj" />
    <ProjectReference Include="..\..\Mods\Ticket\Spec\Ticket.Spec.csproj" />
    <ProjectReference Include="..\..\Mods\File\Src\File.Src.csproj" />
    <ProjectReference Include="..\..\Mods\File\Spec\File.Spec.csproj" />
    <ProjectReference Include="..\..\Mods\Chat\Src\Chat.Src.csproj" />
    <ProjectReference Include="..\..\Mods\Chat\Spec\Chat.Spec.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\uploads\" />
  </ItemGroup>

</Project>
